# Duel Rush Server Environment Variables

# Server
PORT=3000
NODE_ENV=development

# Network URLs
WS_SERVER_URL=ws://localhost:3000
HTTP_SERVER_URL=http://localhost:3000

# Database (Development - Local)
MONGODB_URI=mongodb://127.0.0.1:27017/duelrush

# Database (Production - Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/duelrush_prod

# API Keys (Optional)
# GOOGLE_PLAY_API_KEY=your-api-key-here
# FIREBASE_API_KEY=your-firebase-key-here

